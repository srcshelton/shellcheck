#!/bin/bash
set -euxo pipefail
shopt -s extglob

export EDITOR="touch"

gh --version

for tag in $TAGS
do
  if ! gh release view "$tag" >/dev/null 2>&1
  then
    echo "Creating new release $tag"
    git show --no-patch  --format='format:%B' > description
    gh release create "$tag" \
      --target "${GITHUB_SHA:-HEAD}" \
      --title "$tag" \
      --notes-file description
  fi

  files=()
  for file in deploy/*
  do
    [[ $file == *.@(xz|gz|zip) ]] || continue
    [[ $file == *"$tag"* ]] || continue
    files+=("$file")
  done
  if [[ ${#files[@]} -eq 0 ]]
  then
    echo "No release files found for $tag" >&2
    exit 1
  fi
  gh release upload "$tag" "${files[@]}" --clobber
done
