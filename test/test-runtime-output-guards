#!/usr/bin/env python3
"""Exercise native preflights with mock uname/id/df, not native shell semantics."""
import os
from pathlib import Path
import subprocess
import tempfile
import unittest

REPO = Path(__file__).resolve().parent.parent


class OutputGuardTests(unittest.TestCase):
    def test_irix_uid_and_parent_guards(self):
        with tempfile.TemporaryDirectory(prefix="runtime-guards-", dir=os.environ["IRIX_TEST_PARENT"]) as name:
            root = Path(name)
            for script, boundary in [("test/exit-scope-runtime", "for shell in $shells; do"),
                                     ("builders/irix/test-native-exit-trap-scope", "count=0")]:
                prefix = (REPO / script).read_text().split(boundary, 1)[0]
                # Run the real preflight, with only OS identity and free space mocked.
                mocks = '''uname() { echo IRIX64; }
id() { test "$1" = -u || return 99; echo "$TEST_UID"; }
df() { printf 'Filesystem blocks used available capacity mounted\\nmock 1000000 0 1000000 0%% /\\n'; }
'''
                for uid, exists in [(12345, True), (0, True), (12345, False)]:
                    parent = root / (Path(script).name + str(uid) + str(exists))
                    if exists:
                        parent.mkdir()
                    result = subprocess.run(["/bin/bash", "-c", mocks + prefix + '\nprintf "PASS preflight\\n"\n',
                                             "test", str(parent)], capture_output=True, text=True,
                                            env=dict(os.environ, TEST_UID=str(uid), IRIX_TEST_PARENT=str(parent)))
                    with self.subTest(script=script, uid=uid, exists=exists):
                        self.assertEqual(result.returncode, 0 if uid and exists else 2, result.stderr)
                        if uid and exists:
                            fixtures = list(parent.iterdir())
                            self.assertEqual(len(fixtures), 1)
                            self.assertEqual(fixtures[0].stat().st_mode & 0o777, 0o700)
                        elif exists:
                            self.assertEqual(list(parent.iterdir()), [])


if __name__ == "__main__":
    unittest.main()
