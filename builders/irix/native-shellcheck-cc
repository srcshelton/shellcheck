#!/usr/local/bin/bash
# Private Fuel-only generated-C/assembler driver. Never edit the seed wrapper.
set -euo pipefail
source "$(dirname "$0")/native-consumer-profile"
if [ "$profile" = mipspro ]; then
    helpers="$run_root/repository/builders/irix"
    exec "$BASH" "$helpers/collapse-library-search-paths" \
        "$run_root/ghc-7.10.3/libraries" "$consumer/.library-search-ghc710" "$BASH" \
        "$helpers/collapse-library-search-paths" \
        "$run_root/ghc-7.6.3/libraries" "$consumer/.library-search-ghc76" "$BASH" \
        "$consumer/harness/native-mipspro-cc" \
        -I"$run_root/gmp-bootstrap/include" -L"$run_root/gmp-bootstrap/lib" "$@"
fi
[ "$profile" = optimized ] || { echo 'Optimised adapter needs its private profile' >&2; exit 2; }
merge=false
compile=false
for argument in "$@"; do
    case "$argument" in
        -ffast-math|-Ofast|-funsafe-math-optimizations|-fstrict-aliasing)
            echo "Unsafe optimisation option rejected: $argument" >&2; exit 2 ;;
        -mabi=*) [ "$argument" = -mabi=n32 ] || exit 2 ;;
        -Wl,-r) merge=true ;;
        -c|-S|-E) compile=true ;;
    esac
done
cpu_options=(-mabi=n32 -mips4 -mtune=mips4 -O2)
if ! $merge || $compile; then
    cpu_options+=(-fno-strict-aliasing -fwrapv -mno-fused-madd)
fi
helpers="$run_root/repository/builders/irix"
exec "$BASH" "$helpers/collapse-library-search-paths" \
    "$run_root/ghc-7.10.3/libraries" "$consumer/.library-search-ghc710" "$BASH" \
    "$helpers/collapse-library-search-paths" \
    "$run_root/ghc-7.6.3/libraries" "$consumer/.library-search-ghc76" "$BASH" \
    "$helpers/irix-gcc-compat" /usr/nekoware/bin/gcc \
    -I"$run_root/gmp-bootstrap/include" -L"$run_root/gmp-bootstrap/lib" \
    "$@" "${cpu_options[@]}"
