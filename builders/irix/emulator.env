# Published sgidevnet IRIX 6.5.22 worker, pinned to the image used by the
# experimental GitHub-hosted emulator controller.
IRIX_WORKER_IMAGE=ghcr.io/sgidevnet/irix-worker@sha256:6be7c6c3f92d15705f2d08a3d1b919d6f6241b5364ced22ae0d962820e4724cd
IRIX_WORKER_PLATFORM=linux/amd64
IRIX_WORKER_UPSTREAM_COMMIT=b2e2ff1225beff8cbaa31e81adb49b4fab376b15

# GHC 6.4.2 is the newest documented GHC release with an unregisterised
# mips64-sgi-irix6 port. It is the first rung of the native bootstrap.
IRIX_GHC_VERSION=6.4.2
IRIX_GHC_SOURCE_URL=https://downloads.haskell.org/~ghc/6.4.2/ghc-6.4.2-src.tar.bz2
IRIX_GHC_SOURCE_SHA256=d517e52e0204a077c54cda11b67bf9b6ac3daa47ac7bccf1561afc7c572e6be0

# The worker's system Perl is 5.00405, while GHC 6.4.2 requires at least 5.6.
# Build only miniperl in disposable guest storage as a bootstrap prerequisite.
IRIX_PERL_VERSION=5.8.9
IRIX_PERL_SOURCE_URL=https://www.cpan.org/src/5.0/perl-5.8.9.tar.bz2
IRIX_PERL_SOURCE_SHA256=1097fbcd48ceccb2bc735d119c9db399a02a8ab9f7dc53e29e47e6a8d0d72e79

# GHC rejects its bundled GMP 3.1.1 on mips64. Use a contemporary external
# release, built as generic C for the portable MIPS III bootstrap seed.
IRIX_GMP_VERSION=4.2.1
IRIX_GMP_SOURCE_URL=https://ftp.gnu.org/gnu/gmp/gmp-4.2.1.tar.bz2
IRIX_GMP_SOURCE_SHA256=d07ffcb37eecec35c5ec72516d10b35fdf6e6fef1fcf1dcd37e30b8cbf8bf941
