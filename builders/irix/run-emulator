#!/usr/bin/env bash

set -euo pipefail

stage=${1:-ghc-configure}
case "$stage" in
    environment|toolchain|ghc-configure) ;;
    *) echo "run-emulator: unsupported stage: $stage" >&2; exit 2 ;;
esac

repo_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)
# shellcheck source=builders/irix/emulator.env
source "$repo_root/builders/irix/emulator.env"

case "$IRIX_WORKER_IMAGE" in
    *@sha256:*) ;;
    *) echo 'run-emulator: worker image must be digest-pinned' >&2; exit 2 ;;
esac

container_command=${IRIX_CONTAINER_COMMAND:-docker}
command -v "$container_command" >/dev/null 2>&1 || {
    echo "run-emulator: container command not found: $container_command" >&2
    exit 1
}

runtime_parent=${IRIX_EMULATOR_RUNTIME_PARENT:-${RUNNER_TEMP:-"$repo_root/.worktrees"}}
run_token=${GITHUB_RUN_ID:-local}-${GITHUB_RUN_ATTEMPT:-1}-$$
runtime_dir="$runtime_parent/irix-shellcheck-$run_token"
artifact_dir=${IRIX_EMULATOR_ARTIFACT_DIR:-"$repo_root/artifacts/irix-experiment"}
job_dir="$runtime_dir/job"
volume_name="irix-shellcheck-$run_token"
container_name="irix-shellcheck-$run_token"
keep_runtime=${IRIX_KEEP_EMULATOR_WORK:-0}
volume_created=0

case "$keep_runtime" in
    0|1) ;;
    *) echo 'run-emulator: IRIX_KEEP_EMULATOR_WORK must be 0 or 1' >&2; exit 2 ;;
esac

# Invoked indirectly by the EXIT trap.
# shellcheck disable=SC2329
cleanup()
{
    result_code=$?
    "$container_command" rm -f "$container_name" >/dev/null 2>&1 || true
    if [[ $volume_created -eq 1 ]]
    then
        "$container_command" volume rm "$volume_name" >/dev/null 2>&1 || true
    fi
    if [[ $keep_runtime -eq 0 ]]
    then
        case "$runtime_dir" in
            "$runtime_parent"/irix-shellcheck-*) rm -rf -- "$runtime_dir" ;;
            *) echo "run-emulator: refusing to clean unexpected path: $runtime_dir" >&2 ;;
        esac
    else
        echo "run-emulator: retained runtime: $runtime_dir" >&2
    fi
    exit "$result_code"
}
trap cleanup EXIT
trap 'exit 130' INT TERM HUP

mkdir -p "$job_dir/artifacts" "$artifact_dir"
cp "$repo_root/builders/irix/emulator-entrypoint" "$job_dir/"
cp "$repo_root/builders/irix/guest-experiment" "$job_dir/"
printf '%s\n' "$stage" > "$job_dir/stage"
(
    cd "$repo_root"
    tar --exclude=.git --exclude=.worktrees --exclude=artifacts -cf "$job_dir/repository.tar" .
)

if [[ $stage == ghc-configure ]]
then
    source_archive="$job_dir/ghc-$IRIX_GHC_VERSION-src.tar.bz2"
    if [[ -n ${IRIX_GHC_SOURCE_ARCHIVE:-} ]]
    then
        cp "$IRIX_GHC_SOURCE_ARCHIVE" "$source_archive"
    else
        curl -L --fail --retry 3 --show-error \
            -o "$source_archive" "$IRIX_GHC_SOURCE_URL"
    fi
    if command -v sha256sum >/dev/null 2>&1
    then
        actual_sha256=$(sha256sum "$source_archive" | awk '{print $1}')
    else
        actual_sha256=$(shasum -a 256 "$source_archive" | awk '{print $1}')
    fi
    if [[ $actual_sha256 != "$IRIX_GHC_SOURCE_SHA256" ]]
    then
        echo "run-emulator: GHC source digest mismatch: $actual_sha256" >&2
        exit 1
    fi
    bzip2 -dc "$source_archive" > "$job_dir/ghc-$IRIX_GHC_VERSION-src.tar"
    rm "$source_archive"

    perl_source_archive="$job_dir/perl-$IRIX_PERL_VERSION.tar.bz2"
    if [[ -n ${IRIX_PERL_SOURCE_ARCHIVE:-} ]]
    then
        cp "$IRIX_PERL_SOURCE_ARCHIVE" "$perl_source_archive"
    else
        curl -L --fail --retry 3 --show-error \
            -o "$perl_source_archive" "$IRIX_PERL_SOURCE_URL"
    fi
    if command -v sha256sum >/dev/null 2>&1
    then
        actual_sha256=$(sha256sum "$perl_source_archive" | awk '{print $1}')
    else
        actual_sha256=$(shasum -a 256 "$perl_source_archive" | awk '{print $1}')
    fi
    if [[ $actual_sha256 != "$IRIX_PERL_SOURCE_SHA256" ]]
    then
        echo "run-emulator: Perl source digest mismatch: $actual_sha256" >&2
        exit 1
    fi
    bzip2 -dc "$perl_source_archive" > "$job_dir/perl-$IRIX_PERL_VERSION.tar"
    rm "$perl_source_archive"

    gmp_source_archive="$job_dir/gmp-$IRIX_GMP_VERSION.tar.bz2"
    if [[ -n ${IRIX_GMP_SOURCE_ARCHIVE:-} ]]
    then
        cp "$IRIX_GMP_SOURCE_ARCHIVE" "$gmp_source_archive"
    else
        curl -L --fail --retry 3 --show-error \
            -o "$gmp_source_archive" "$IRIX_GMP_SOURCE_URL"
    fi
    if command -v sha256sum >/dev/null 2>&1
    then
        actual_sha256=$(sha256sum "$gmp_source_archive" | awk '{print $1}')
    else
        actual_sha256=$(shasum -a 256 "$gmp_source_archive" | awk '{print $1}')
    fi
    if [[ $actual_sha256 != "$IRIX_GMP_SOURCE_SHA256" ]]
    then
        echo "run-emulator: GMP source digest mismatch: $actual_sha256" >&2
        exit 1
    fi
    bzip2 -dc "$gmp_source_archive" > "$job_dir/gmp-$IRIX_GMP_VERSION.tar"
    rm "$gmp_source_archive"
fi

{
    echo "worker_image=$IRIX_WORKER_IMAGE"
    echo "worker_platform=$IRIX_WORKER_PLATFORM"
    echo "worker_upstream_commit=$IRIX_WORKER_UPSTREAM_COMMIT"
    echo "requested_stage=$stage"
    echo "ghc_version=$IRIX_GHC_VERSION"
    echo "ghc_source_sha256=$IRIX_GHC_SOURCE_SHA256"
    echo "perl_version=$IRIX_PERL_VERSION"
    echo "perl_source_sha256=$IRIX_PERL_SOURCE_SHA256"
    echo "gmp_version=$IRIX_GMP_VERSION"
    echo "gmp_source_sha256=$IRIX_GMP_SOURCE_SHA256"
} > "$artifact_dir/controller.env"

"$container_command" volume create "$volume_name" >/dev/null
volume_created=1
(
    cd "$job_dir"
    tar cf - .
) | "$container_command" run --rm -i \
    --platform "$IRIX_WORKER_PLATFORM" \
    --volume "$volume_name:/job" \
    --entrypoint tar \
    "$IRIX_WORKER_IMAGE" xf - -C /job

set +e
"$container_command" run --rm \
    --platform "$IRIX_WORKER_PLATFORM" \
    --name "$container_name" \
    --env "JOB_TIMEOUT=${IRIX_EMULATOR_JOB_TIMEOUT:-18000}" \
    --volume "$volume_name:/job" \
    --entrypoint /job/emulator-entrypoint \
    "$IRIX_WORKER_IMAGE" 2>&1 | tee "$artifact_dir/emulator-console.log"
emulator_status=${PIPESTATUS[0]}
set -e

mkdir -p "$artifact_dir/guest"
set +e
"$container_command" run --rm \
    --platform "$IRIX_WORKER_PLATFORM" \
    --volume "$volume_name:/job" \
    --entrypoint sh \
    "$IRIX_WORKER_IMAGE" -c \
    'test -d /job/artifacts && tar cf - -C /job/artifacts .' | (
        cd "$artifact_dir/guest"
        tar xf -
    )
evidence_status=${PIPESTATUS[0]}
set -e

{
    echo "emulator_status=$emulator_status"
    echo "evidence_status=$evidence_status"
} >> "$artifact_dir/controller.env"

if [[ $emulator_status -ne 0 ]]
then
    exit "$emulator_status"
fi
exit "$evidence_status"
