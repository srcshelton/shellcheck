#!/bin/sh

# Start the published IRIX worker as a controller-driven emulator. This keeps
# the experimental job on a GitHub-hosted Linux runner and does not require a
# permanently registered self-hosted runner.
set -u

export IRIS_SOCKET=/tmp/iris.sock
CI=/opt/iris/iris-ci
BOOT_TIMEOUT=${BOOT_TIMEOUT:-900}
JOB_TIMEOUT=${JOB_TIMEOUT:-18000}
SNAPSHOT=${SNAPSHOT:-golden}
IRIS_PID=
TAIL_PID=

# Invoked indirectly by the EXIT trap.
# shellcheck disable=SC2329
finish()
{
    result_code=$?
    trap - 0
    if [ -n "$IRIS_PID" ]
    then
        "$CI" quit >/dev/null 2>&1 || true
        kill "$IRIS_PID" >/dev/null 2>&1 || true
        wait "$IRIS_PID" >/dev/null 2>&1 || true
    fi
    if [ -n "$TAIL_PID" ]
    then
        kill "$TAIL_PID" >/dev/null 2>&1 || true
        wait "$TAIL_PID" >/dev/null 2>&1 || true
    fi
    if [ "$result_code" -ne 0 ]
    then
        tail -40 /tmp/console.log /tmp/iris.log >&2 2>/dev/null || true
    fi
    exit "$result_code"
}

fail()
{
    echo "emulator-entrypoint: $*" >&2
    exit 1
}

trap finish 0
trap 'exit 130' 1 2 3 15

for required_file in repository.tar guest-experiment stage
do
    [ -f "/job/$required_file" ] || fail "missing /job/$required_file"
done

stage=$(sed -n '1p' /job/stage)
case "$stage" in
    environment|toolchain|ghc-configure) ;;
    *) fail "unsupported stage: $stage" ;;
esac
case "$JOB_TIMEOUT" in
    ''|*[!0-9]*|0) fail 'JOB_TIMEOUT must be a positive integer' ;;
esac

cd /opt/iris || fail 'cannot enter /opt/iris'
./iris --config worker.toml >/tmp/iris.log 2>&1 &
IRIS_PID=$!

n=0
while [ ! -S "$IRIS_SOCKET" ] && [ "$n" -lt 60 ]
do
    sleep 1
    n=$((n + 1))
done
[ -S "$IRIS_SOCKET" ] || fail 'iris never opened its control socket'

"$CI" start -q || fail 'machine would not start'
if [ -d "saves/$SNAPSHOT" ]
then
    "$CI" serial-wait --timeout 120 -q 'power-on diagnostics' ||
        fail 'machine never reached the PROM'
    "$CI" restore -q "$SNAPSHOT" || fail "restore of $SNAPSHOT failed"
else
    "$CI" serial-wait --timeout "$BOOT_TIMEOUT" -q 'console login:' ||
        fail 'guest did not reach a login prompt'
    "$CI" login root -q || fail 'login failed'
fi

"$CI" run --shell sh --timeout 60 -q \
    "date -u $(date -u +%m%d%H%M%Y)" >/dev/null 2>&1 ||
    fail 'could not set the guest clock'
"$CI" run --shell sh --timeout 150 -q \
    'umount /job; mount -o vers=3,noac 192.168.0.1:/ /job' >/dev/null 2>&1 ||
    fail 'could not remount the job export'
"$CI" run --shell sh --timeout 60 -q \
    'test -f /job/repository.tar -a -f /job/guest-experiment' ||
    fail 'guest could not read the job export'

rm -f /job/guest-status /job/guest-status.tmp
: > /job/guest-console.log
mkdir -p /job/artifacts || fail 'could not prepare artifact directory'

# A long iris-ci run request is limited by its own socket timeout. Start the
# work in the guest, then observe completion through the remounted NFS export.
"$CI" run --shell sh --timeout 60 -q \
    "IRIX_EXPERIMENT_STAGE='$stage' nohup sh /job/guest-experiment > /job/guest-console.log 2>&1 </dev/null & :" ||
    fail 'could not start the guest experiment'

tail -n +1 -f /job/guest-console.log &
TAIL_PID=$!
elapsed=0
while [ ! -f /job/guest-status ] && [ "$elapsed" -lt "$JOB_TIMEOUT" ]
do
    kill -0 "$IRIS_PID" 2>/dev/null || fail 'iris exited during the guest experiment'
    sleep 5
    elapsed=$((elapsed + 5))
    if [ $((elapsed % 30)) -eq 0 ]
    then
        echo "emulator-entrypoint: IRIX experiment active; elapsed=${elapsed}s"
    fi
done
[ -f /job/guest-status ] || fail "guest experiment exceeded ${JOB_TIMEOUT}s"

guest_status=$(sed -n '1p' /job/guest-status)
case "$guest_status" in
    ''|*[!0-9]*) fail "guest returned invalid status: $guest_status" ;;
esac
sleep 2
kill "$TAIL_PID" >/dev/null 2>&1 || true
wait "$TAIL_PID" >/dev/null 2>&1 || true
TAIL_PID=
exit "$guest_status"
