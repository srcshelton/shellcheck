#!/bin/sh

# Keep ABI, ISA, and processor scheduling explicit. The R4000 baseline is the
# only MIPS III artifact; every later processor implements MIPS IV.
case "${1-}" in
    --list)
        printf '%s\n' \
            irix.mips3.n32.r4k \
            irix.mips4.n32.r5k \
            irix.mips4.n32.r10k \
            irix.mips4.n32.r12k \
            irix.mips4.n32.r14k
        ;;
    --bootstrap-gcc) printf '%s\n' '-mabi=n32 -mips3 -mtune=r4400' ;;
    irix.mips3.n32.r4k) printf '%s\n' '-n32 -mips3 -r4000 -O2' ;;
    irix.mips4.n32.r5k) printf '%s\n' '-n32 -mips4 -r5000 -O2' ;;
    irix.mips4.n32.r10k) printf '%s\n' '-n32 -mips4 -r10000 -O2' ;;
    irix.mips4.n32.r12k) printf '%s\n' '-n32 -mips4 -r12000 -O2' ;;
    irix.mips4.n32.r14k) printf '%s\n' '-n32 -mips4 -r14000 -O2' ;;
    *)
        echo "target-flags: unsupported target: ${1-<missing>}" >&2
        exit 2
        ;;
esac
