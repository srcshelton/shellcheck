#!/usr/bin/env bash
set -euo pipefail
here=$(cd -- "$(dirname -- "$0")" && pwd)
parent=${IRIX_TEST_PARENT:?Set IRIX_TEST_PARENT to a durable session test directory}
original=${IRIX_TEXT_SOURCE:?Set IRIX_TEXT_SOURCE to the pinned unmodified source tree}
mkdir -p "$parent"
test_dir=$(mktemp -d "$parent/text-mipspro-overlay.XXXXXXXX")
trap 'status=$?; trap - EXIT; rm -rf "$test_dir"; exit "$status"' EXIT
mkdir "$test_dir/sources"
cp -R "$original" "$test_dir/sources/text-1.2.3.1"
export IRIX_PATCH=${IRIX_PATCH-$(command -v patch)}
export IRIX_CONSUMER_PROFILE=mipspro
bash "$here/apply-native-dependency-overlays" "$test_dir/sources" || exit "$?"
bash "$here/apply-native-dependency-overlays" "$test_dir/sources" || exit "$?"
patched="$test_dir/sources/text-1.2.3.1/cbits/cbits.c"
test "$(cksum "$patched" | awk '{print $1 " " $2}')" = '2216481543 8590' || exit 1
compiler=${CC-cc}
"$compiler" -O2 -I"$original/include" "$original/cbits/cbits.c" "$here/text-memory-smoke.c" -o "$test_dir/original" || exit "$?"
"$compiler" -O2 -I"$original/include" "$patched" "$here/text-memory-smoke.c" -o "$test_dir/patched" || exit "$?"
"$test_dir/original" > "$test_dir/original.out" || exit "$?"
"$test_dir/patched" > "$test_dir/patched.out" || exit "$?"
cmp "$test_dir/original.out" "$test_dir/patched.out" || exit "$?"
status=0
IRIX_CONSUMER_PROFILE=optimized bash "$here/apply-native-dependency-overlays" "$test_dir/sources" > "$test_dir/rejected-switch.log" 2>&1 || status=$?
test "$status" = 2 || exit 1
printf '\nchanged\n' >> "$patched"
status=0
bash "$here/apply-native-dependency-overlays" "$test_dir/sources" > "$test_dir/rejected-preimage.log" 2>&1 || status=$?
test "$status" = 2 || exit 1
echo 'PASS text MIPSpro overlay replay, idempotency, runtime guards and cross-profile/preimage refusal'
