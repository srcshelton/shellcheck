#!/usr/bin/env bash
set -euo pipefail
here=$(cd -- "$(dirname -- "$0")" && pwd)
parent=${IRIX_TEST_PARENT:?Set IRIX_TEST_PARENT to a durable session test directory}
mkdir -p "$parent"
if command -v mktemp >/dev/null 2>&1; then
    fixture=$(mktemp -d "$parent/native-selected.XXXXXXXX")
else
    fixture="$parent/native-selected.$$"
    mkdir "$fixture"
fi
trap 'result=$?; trap - EXIT; rm -rf "$fixture"; exit "$result"' EXIT
export IRIX_RUN_ROOT="$fixture" FAKE_SELECTED_CALLS="$fixture/calls"
consumer="$fixture/shellcheck-native-mipspro"
mkdir -p "$consumer/harness" "$consumer/source" "$consumer/sources" "$consumer/bin"
printf '%s\n' fuel-mips4-r14000-n32-mipspro744m-ghc7103-O2-v1 > "$consumer/build-profile"
cp "$here/build-native-selected" "$here/native-consumer-profile" "$here/native-run-root" "$consumer/harness/"
printf '#!/bin/sh\nexit 0\n' > "$consumer/bin/native-setup"
chmod +x "$consumer/bin/native-setup"
printf 'pinned mock plan\n' > "$consumer/dependencies.plan"
printf 'pinned mock Cabal\n' > "$consumer/source/ShellCheck.cabal"
printf '%s\n' '#!/bin/sh' 'test "$1" = --check || exit 71' \
    'test "${FAIL_SELECTION-0}" = 0 || exit 72' 'echo mipspro' > "$consumer/harness/select-native-compiler"
printf '%s\n' '#!/bin/sh' 'test "$IRIX_CONSUMER_PROFILE" = mipspro || exit 73' \
    'echo dependencies >> "$FAKE_SELECTED_CALLS"' \
    'test "${FAIL_PHASE-}" != dependencies || exit 74' > "$consumer/harness/build-native-dependencies"
printf '%s\n' '#!/bin/sh' 'test "$IRIX_CONSUMER_PROFILE" = mipspro || exit 73' \
    'echo shellcheck >> "$FAKE_SELECTED_CALLS"' \
    'test "${FAIL_PHASE-}" != shellcheck || exit 74' > "$consumer/harness/build-native-shellcheck"
status=0
FAIL_SELECTION=1 bash "$consumer/harness/build-native-selected" auto >/dev/null 2>&1 || status=$?
test "$status" = 72 && test ! -e "$FAKE_SELECTED_CALLS" || exit 1
status=0
FAIL_PHASE=dependencies bash "$consumer/harness/build-native-selected" auto >/dev/null 2>&1 || status=$?
test "$status" = 74 && test "$(cat "$FAKE_SELECTED_CALLS")" = dependencies || exit 1
: > "$FAKE_SELECTED_CALLS"
bash "$consumer/harness/build-native-selected" mipspro || exit "$?"
test "$(cat "$FAKE_SELECTED_CALLS")" = $'dependencies\nshellcheck' || exit 1
rm "$consumer/harness/select-native-compiler"
export IRIX_CONSUMER_PROFILE=mipspro
status=0
bash "$here/build-native-dependencies" >/dev/null 2>&1 || status=$?
test "$status" -ne 0 && test ! -d "$consumer/package.conf.d" || exit 1
status=0
bash "$here/build-native-shellcheck" >/dev/null 2>&1 || status=$?
test "$status" -ne 0 && test ! -e "$consumer/native-ready" || exit 1
echo 'PASS selected build profile, selection/failure gating, phase ordering and direct-entry seal requirement (mock contracts only)'
