#!/usr/bin/env bash

set -euo pipefail

script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)

bash -n "$script_dir/run-emulator"
sh -n "$script_dir/emulator-entrypoint"
sh -n "$script_dir/guest-experiment"
sh -n "$script_dir/target-flags"

# Literal pattern: command substitution is forbidden in the IRIX guest script.
# shellcheck disable=SC2016
if grep -nF '$(' "$script_dir/guest-experiment"
then
    echo "test-scripts: IRIX /sbin/sh does not support \$(...) substitution" >&2
    exit 1
fi

expected=$(printf '%s\n' \
    irix.mips3.n32.r4k \
    irix.mips4.n32.r5k \
    irix.mips4.n32.r10k \
    irix.mips4.n32.r12k \
    irix.mips4.n32.r14k)
actual=$("$script_dir/target-flags" --list)
[[ $actual == "$expected" ]]

[[ $("$script_dir/target-flags" irix.mips3.n32.r4k) == '-n32 -mips3 -r4000 -O2' ]]
[[ $("$script_dir/target-flags" irix.mips4.n32.r5k) == '-n32 -mips4 -r5000 -O2' ]]
[[ $("$script_dir/target-flags" irix.mips4.n32.r10k) == '-n32 -mips4 -r10000 -O2' ]]
[[ $("$script_dir/target-flags" irix.mips4.n32.r12k) == '-n32 -mips4 -r12000 -O2' ]]
[[ $("$script_dir/target-flags" irix.mips4.n32.r14k) == '-n32 -mips4 -r14000 -O2' ]]
[[ $("$script_dir/target-flags" --bootstrap-gcc) == '-mabi=n32 -mips3 -mtune=r4400' ]]

if "$script_dir/target-flags" unsupported >/dev/null 2>&1
then
    echo 'test-scripts: unknown targets must fail' >&2
    exit 1
fi
