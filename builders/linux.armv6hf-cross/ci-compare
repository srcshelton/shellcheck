#!/usr/bin/env python3
"""Run each CLI contract on both same-source ARM binaries, byte for byte."""
import base64
import json
import os
import subprocess
import sys

data = sys.stdin.buffer.read()
results = []
for kind in ("candidate", "reference"):
    results.append(subprocess.run(
        ["qemu-arm-static", "-cpu", "arm1176",
         f"/evidence/{kind}/linux.armv6hf/shellcheck", *sys.argv[1:]],
        input=data, capture_output=True, timeout=120))
candidate, reference = results
equal = (candidate.returncode, candidate.stdout, candidate.stderr) == (
    reference.returncode, reference.stdout, reference.stderr)
record = {"args": sys.argv[1:], "equal": equal,
          "status": [r.returncode for r in results]}
if not equal:
    record["stdin_b64"] = base64.b64encode(data).decode()
    record["outputs"] = [{"stdout_b64": base64.b64encode(r.stdout).decode(),
                          "stderr_b64": base64.b64encode(r.stderr).decode()}
                         for r in results]
with open(os.environ["ARMV6_COMPARISON_LOG"], "a") as log:
    log.write(json.dumps(record) + "\n")
if not equal:
    sys.exit("ARMv6 old/new CLI mismatch; see comparison.jsonl")
sys.stdout.buffer.write(candidate.stdout)
sys.stderr.buffer.write(candidate.stderr)
sys.exit(candidate.returncode)
