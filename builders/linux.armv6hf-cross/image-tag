#!/usr/bin/env python3
"""Return the GHCR channel for the pinned GHC/ARMv6 image recipe."""
import hashlib
from pathlib import Path
import re


root = Path(__file__).resolve().parent
dockerfile = (root / "Dockerfile").read_text()
versions = set(re.findall(r"ghc-(\d+\.\d+\.\d+)-src\.tar\.xz", dockerfile))
if len(versions) != 1:
    raise SystemExit("expected one pinned GHC source version in Dockerfile")
version = versions.pop()

# These files affect CI selection/qualification, not the Docker image itself.
excluded = {"README.md", "ghcr-tag", "image-tag", "run-preferred"}
recipe = sorted(
    path for path in root.iterdir()
    if path.is_file() and path.name not in excluded
    and not path.name.startswith(("ci-", "test-"))
)
if root / "Dockerfile" not in recipe:
    raise SystemExit("missing cross-GHC image recipe")
digest = hashlib.sha256()
for path in recipe:
    digest.update(path.name.encode() + b"\0")
    digest.update(path.read_bytes() + b"\0")
print(f"ghc-{version}-armv6hf-{digest.hexdigest()[:16]}")
