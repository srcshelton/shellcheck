#!/bin/bash
# This script packages up compiled binaries
set -ex
shopt -s nullglob extglob

ls -l

cp ../LICENSE LICENSE.txt
source_revision=${SOURCE_REVISION:-$(git rev-parse HEAD)}
source_version=${SOURCE_VERSION:-$(git describe --always)}
case "$source_revision" in ''|*[!0-9a-f]*) echo 'Invalid source revision' >&2; exit 2 ;; esac
test "${#source_revision}" = 40 || { echo 'Expected full source commit ID' >&2; exit 2; }
case "$source_version" in ''|*[!a-zA-Z0-9_.+-]*) echo 'Invalid source version' >&2; exit 2 ;; esac
sed -e $'s/$/\r/' > README.txt << END
This is a precompiled binary from the srcshelton/ShellCheck fork.
      https://github.com/srcshelton/shellcheck

ShellCheck is a static analysis tool for shell scripts.
It's licensed under the GNU General Public License v3.0.
It includes general diagnostic corrections and additions, optional checks,
and opt-in IRIX shell profiles. IRIX-specific behaviour does not replace the
normal general-purpose shell profiles. The upstream online checker may not
include these additions.

Source version: $source_version
Source revision: $source_revision
Source: https://github.com/srcshelton/shellcheck/tree/$source_revision
Changes: https://github.com/srcshelton/shellcheck/blob/$source_revision/CHANGELOG.md
Usage: https://github.com/srcshelton/shellcheck/blob/$source_revision/shellcheck.1.md
Issues: https://github.com/srcshelton/shellcheck/issues

Upstream ShellCheck: https://github.com/koalaman/shellcheck
END

for dir in */
do
  cp LICENSE.txt README.txt "$dir"
done

echo "Tags are $TAGS"

for tag in $TAGS
do

  for dir in windows.*/
  do
    ( cd "$dir" && zip "../shellcheck-$tag.zip" * )
  done

  for dir in {linux,darwin}.*/
  do
    base="${dir%/}"
    ( cd "$dir" && tar -cJf "../shellcheck-$tag.$base.tar.xz" --transform="s:^:shellcheck-$tag/:" * )
    ( cd "$dir" && tar -czf "../shellcheck-$tag.$base.tar.gz" --transform="s:^:shellcheck-$tag/:" * )
  done
done

for file in ./*
do
  [[ -f "$file" ]] || continue
  sha512sum "$file" > "$file.sha512sum"
done

ls -l
